# ESP-IDF build output
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Prebuilt firmware produced by the build (flash.bat reads these)
firmware/*.bin
firmware/*.elf

# Downloaded tool (esptool v4.8.1 standalone, see README)
tools/esptool.exe
tools/LICENSE

# Runtime / log files from flashing
flash_log.txt
serial_log.txt
flash_helper_output.txt
flash.request
reboot.request
flash.running
flash.done
flash.status
flash_helper.log
stop.request
serial_live.txt
serial.send
serial.send.tmp
harness.ask
tools/harness/reports/
tools/harness/__pycache__/
snapshot_*.png

# Web flasher / CI outputs
_site/
dist/
version.txt

# Files copied in by Claude sessions
firmware/in/
tools/harness/.display_key
tools/harness/.setup_profile.xml
tools/harness/baseline.proposed.json
tools/harness/.display_ip
.espforge/
